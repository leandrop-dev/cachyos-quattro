#!/bin/bash
# Print the pacman NoExtract drop-in for the noextract rows of a files ledger.
#
#   tools/gen-noextract ledger/files.tsv >cachyos-quattro.conf
#
# Every row must be an exact path. A glob or a negation would also change files
# nobody reviewed, so either one fails the build.

set -euo pipefail

(($# == 1)) || {
  echo "usage: tools/gen-noextract <files.tsv>" >&2
  exit 2
}

echo "# Generated by tools/gen-noextract from the cachyos-quattro ledger (ledger/files.tsv)."
echo "# Read by pacman through 'Include = /etc/pacman.d/cachyos-quattro.conf' in [options]."
awk -F'\t' '
  /^#/ || $2 != "noextract" { next }
  $1 == "" || $1 ~ /[*?[]|^[\/!]/ {
    printf "gen-noextract: line %d: \"%s\" is not an exact path\n", NR, $1 > "/dev/stderr"
    bad = 1
    next
  }
  { print "NoExtract = " $1 }
  END { exit bad }
' "$1"
