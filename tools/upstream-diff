#!/bin/bash
# Markdown review report for a new Omarchy release: what changed in the areas cachyos-quattro
# reviews, measured against the reviewed ledger. The upstream-watch workflow posts it as the
# body of a "Review Omarchy <version>" issue; docs/reviewing-a-release.md says how to act on it.
#
#   tools/upstream-diff <ledger-dir> <old-tree> <new-tree>
#
# <ledger-dir> holds the reviewed ledger (files.tsv, migrations.tsv, install-steps.tsv,
# repo-overlap.tsv). The trees are extracted releases as tools/ledger-gen leaves them:
# <tree>/omarchy/, <tree>/omarchy-settings/ and, when present, <tree>/omarchy.db.

# Single-quoted printf formats hold Markdown backticks, not shell expansions.
# shellcheck disable=SC2016

set -euo pipefail

(($# == 3)) || {
  echo "usage: tools/upstream-diff <ledger-dir> <old-tree> <new-tree>" >&2
  exit 2
}
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ledger=$(cd "$1" && pwd)
old=$(cd "$2" && pwd)
new=$(cd "$3" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

"$root/tools/ledger-scan" "$old" "$work/old"
"$root/tools/ledger-scan" "$new" "$work/new"
version() { sed -n 's/^pkgver = //p' "$1/omarchy/.PKGINFO" | sed 's/-[^-]*$//'; }
ov=$(version "$old")
nv=$(version "$new")
gen() { echo "$work/$1/$2.$([[ $1 == old ]] && echo "$ov" || echo "$nv").${3:-tsv}"; }

# Boot-sensitive paths: the transaction check's Path targets (alpm fnmatch, * matches /).
mapfile -t sensitive < <(sed -n '/^Type = Path$/,/^\[Action\]$/s/^Target = //p' "$root/package/hooks/04-cachyos-quattro-txn-check.hook")
boot_sensitive() {
  local pattern
  for pattern in "${sensitive[@]}"; do
    # shellcheck disable=SC2053
    [[ $1 == $pattern ]] && return 0
  done
  return 1
}
# verdict_of <key> <tsv> [column]: the review verdict for <key> (column 2 unless given).
verdict_of() { awk -F'\t' -v k="$1" -v c="${3:-2}" '!/^#/ && $1 == k { print $c; exit }' "$2"; }
keywords='limine|mkinitcpio|pacman\.conf|mirrorlist|os-release|bootctl|efibootmgr|grub'

findings=0
section() {
  findings=$((findings + 1))
  printf '\n## %s\n\n' "$1"
}
fenced() {
  printf '```%s\n' "${2:-}"
  cat "$1"
  printf '```\n'
}

printf '# Omarchy %s → %s\n\n' "$ov" "$nv"
printf 'Generated by `tools/upstream-diff` against the reviewed ledger. Each section lists a change\n'
printf 'in an area cachyos-quattro reviews; see docs/reviewing-a-release.md for what to do with it.\n'

# 1. Package files under etc/, usr/lib/, usr/local/, usr/share/libalpm/hooks/ and boot/, except
# /etc/skel, which seeds user homes and which the ledger does not review (ledger/files.tsv).
awk -F'\t' '$1 ~ /^etc\/skel\// { next }
  NR == FNR { sum[$1] = $4; pkg[$1] = $2; next }
  { seen[$1] = 1
    if (!($1 in sum)) print "new\t" $1 "\t" $2
    else if (sum[$1] != $4) print "changed\t" $1 "\t" $2 }
  END { for (p in sum) if (!(p in seen)) print "removed\t" p "\t" pkg[p] }' \
  "$(gen old files)" "$(gen new files)" | sort -t$'\t' -k2 >"$work/files.diff"
if [[ -s $work/files.diff ]]; then
  section "Package files outside the desktop payload"
  printf '| change | path | package | note |\n|---|---|---|---|\n'
  while IFS=$'\t' read -r change path pkg; do
    verdict=$(verdict_of "$path" "$ledger/files.tsv")
    if boot_sensitive "$path"; then note="boot-sensitive, "; else note=""; fi
    if [[ -n $verdict ]]; then note+="reviewed as $verdict"; else note+="not in files.tsv"; fi
    printf '| %s | `%s` | %s | %s |\n' "$change" "$path" "$pkg" "$note"
  done <"$work/files.diff"
fi

# 2. The .INSTALL scriptlets, which run as root on every install and upgrade.
for pkg in omarchy omarchy-settings; do
  a=$old/$pkg/.INSTALL b=$new/$pkg/.INSTALL
  [[ -f $a ]] || a=/dev/null
  [[ -f $b ]] || b=/dev/null
  if ! diff -u --label "$pkg $ov .INSTALL" --label "$pkg $nv .INSTALL" "$a" "$b" >"$work/install.diff"; then
    section "$pkg .INSTALL"
    fenced "$work/install.diff" diff
  fi
done

# 3. depend, conflict, provides and replaces.
if ! diff -u --label "$ov" --label "$nv" <(sort "$(gen old packages)") <(sort "$(gen new packages)") >"$work/packages.diff"; then
  section "Package relations"
  fenced "$work/packages.diff" diff
fi

# 4. Migrations: new ones in full, and changed ones with their review status.
awk -F'\t' 'NR == FNR { sum[$1] = $2; next }
  { seen[$1] = 1
    if (!($1 in sum)) print "new\t" $1 "\t" $3 "\t" $4
    else if (sum[$1] != $2) print "changed\t" $1 "\t" $3 "\t" $4 }
  END { for (m in sum) if (!(m in seen)) print "removed\t" m "\t\t" }' \
  "$(gen old migrations)" "$(gen new migrations)" | sort -t$'\t' -k2 >"$work/migrations.diff"
if [[ -s $work/migrations.diff ]]; then
  section "Migrations"
  printf '| change | migration | privileged | note |\n|---|---|---|---|\n'
  while IFS=$'\t' read -r change name privileged summary; do
    note=$summary
    if [[ $change == changed ]]; then
      verdict=$(verdict_of "$name" "$ledger/migrations.tsv" 3)
      case $verdict in
      "" | preseed) note="changed; not individually reviewed" ;;
      *) note="reviewed as $verdict; the gate holds it until re-reviewed" ;;
      esac
    fi
    printf '| %s | `%s` | %s | %s |\n' "$change" "$name" "$privileged" "$note"
  done <"$work/migrations.diff"
  while IFS=$'\t' read -r change name _; do
    [[ $change == new ]] || continue
    printf '\n### `%s`\n\n' "$name"
    fenced "$new/omarchy/usr/share/omarchy/migrations/$name" bash
  done <"$work/migrations.diff"
fi

# 5. Commands: new, removed and requires-sudo changes, plus diffs of the commands the gate and
# the stubs stand in for.
awk -F'\t' 'NR == FNR { sudo[$1] = $2; next }
  { seen[$1] = 1
    if (!($1 in sudo)) print "new\t" $1 "\t" $2
    else if (sudo[$1] != $2) print "requires-sudo " sudo[$1] " → " $2 "\t" $1 "\t" $2 }
  END { for (c in sudo) if (!(c in seen)) print "removed\t" c "\t" sudo[c] }' \
  "$(gen old commands)" "$(gen new commands)" | sort -t$'\t' -k2 >"$work/commands.diff"
bin_old=$old/omarchy/usr/bin bin_new=$new/omarchy/usr/bin
for cmd in "$bin_new"/omarchy-*; do
  name=${cmd##*/}
  if [[ ! -f $bin_old/$name ]] || cmp -s "$bin_old/$name" "$cmd"; then continue; fi
  if grep -qE "$keywords" "$cmd" && ! grep -qE "$keywords" "$bin_old/$name"; then
    printf 'now mentions boot or pacman configuration\t%s\t%s\n' "$name" \
      "$(grep -q '^# omarchy:requires-sudo=true' "$cmd" && echo yes || echo no)" >>"$work/commands.diff"
  fi
done
if [[ -s $work/commands.diff ]]; then
  section "Commands"
  printf '| change | command | requires-sudo | mentions |\n|---|---|---|---|\n'
  while IFS=$'\t' read -r change name sudo; do
    mentions=""
    [[ -f $bin_new/$name ]] && mentions=$(grep -oE "$keywords" "$bin_new/$name" | sort -u | paste -sd ',' | sed 's/,/, /g')
    printf '| %s | `%s` | %s | %s |\n' "$change" "$name" "$sudo" "$mentions"
  done <"$work/commands.diff"
fi
mapfile -t watched_cmds < <(printf '%s\n' omarchy-migrate omarchy-update omarchy-update-system-pkgs omarchy-update-pacman-guard
  grep -v '^#' "$root/package/stubbed-commands.txt")
for name in "${watched_cmds[@]}"; do
  [[ -f $bin_old/$name || -f $bin_new/$name ]] || continue
  a=$bin_old/$name b=$bin_new/$name
  [[ -f $a ]] || a=/dev/null
  [[ -f $b ]] || b=/dev/null
  if ! diff -u --label "$name $ov" --label "$name $nv" "$a" "$b" >"$work/cmd.diff"; then
    section "\`$name\` (the migration gate or a stub stands in for it)"
    fenced "$work/cmd.diff" diff
  fi
done

# 6. Scripts that put $OMARCHY_PATH/bin first in PATH bypass the gate and the stubs.
pattern=$(printf '%s\n' omarchy-migrate "${watched_cmds[@]:4}" | paste -sd '|')
: >"$work/bypass.txt"
# A name counts only where it runs as a command: at the start of a command, optionally by path.
called="(^|[;&|(]|\\\$\\(|\\bthen|\\bdo|\\bexec)[[:space:]]*(/usr/bin/|\"?\\\$OMARCHY_PATH/bin/)?($pattern)\"?([[:space:]]|$)"
for cmd in "$bin_new"/omarchy-*; do
  grep -qF 'export PATH="$OMARCHY_PATH/bin:$PATH"' "$cmd" || continue
  grep -nE "$called" "$cmd" | grep -vE '^[0-9]+:[[:space:]]*#' |
    grep -vE "(/|[[:space:]]|^[0-9]+:)${cmd##*/}([[:space:]\"]|$)" |
    sed "s|^|${cmd##*/}:|" >>"$work/bypass.txt" || true
done
if [[ -s $work/bypass.txt ]]; then
  section "Calls that bypass the migration gate or the stubs"
  printf 'These commands put `$OMARCHY_PATH/bin` first in PATH and then call a gated or stubbed command:\n\n'
  fenced "$work/bypass.txt"
fi

# 7. Install steps and the base package list.
inst_old=$old/omarchy/usr/share/omarchy/install inst_new=$new/omarchy/usr/share/omarchy/install
: >"$work/steps.diff"
while IFS= read -r rel; do
  [[ $rel == *.packages ]] && continue
  if [[ ! -f $inst_old/$rel ]]; then change=new
  elif [[ ! -f $inst_new/$rel ]]; then change=removed
  elif ! cmp -s "$inst_old/$rel" "$inst_new/$rel"; then change=changed
  else continue; fi
  if [[ $rel == */all.sh ]]; then note="run list"; else
    verdict=$(verdict_of "$rel" "$ledger/install-steps.tsv")
    note=${verdict:+reviewed as $verdict}
    note=${note:-not in install-steps.tsv}
  fi
  printf '%s\t%s\t%s\n' "$change" "$rel" "$note" >>"$work/steps.diff"
done < <({ (cd "$inst_old" && find . -type f -printf '%P\n'); (cd "$inst_new" && find . -type f -printf '%P\n'); } | sort -u)
if [[ -s $work/steps.diff ]]; then
  section "Install steps"
  printf '| change | script | note |\n|---|---|---|\n'
  while IFS=$'\t' read -r change rel note; do
    printf '| %s | `%s` | %s |\n' "$change" "$rel" "$note"
  done <"$work/steps.diff"
  while IFS=$'\t' read -r change rel _; do
    [[ $change == removed ]] && continue
    a=$inst_old/$rel
    [[ -f $a ]] || a=/dev/null
    diff -u --label "$rel $ov" --label "$rel $nv" "$a" "$inst_new/$rel" >"$work/step.diff" || true
    printf '\n'
    fenced "$work/step.diff" diff
  done <"$work/steps.diff"
fi
for list in omarchy-base.packages omarchy-other.packages; do
  [[ -f $inst_old/$list || -f $inst_new/$list ]] || continue
  a=$inst_old/$list b=$inst_new/$list
  [[ -f $a ]] || a=/dev/null
  [[ -f $b ]] || b=/dev/null
  if ! diff -u --label "$list $ov" --label "$list $nv" "$a" "$b" >"$work/list.diff"; then
    section "\`$list\`"
    fenced "$work/list.diff" diff
  fi
done

# 8. Packages that [omarchy] shares with the configured repositories (pacman.conf order decides).
if [[ -f $new/omarchy.db ]] && command -v pacman >/dev/null; then
  bsdtar -tf "$new/omarchy.db" | sed -n 's|^\(\./\)\{0,1\}\([^/]*\)-[^-/]*-[^-/]*/$|\2|p' | sort -u >"$work/omarchy-names"
  pacman -Slq | sort -u >"$work/repo-names"
  comm -12 "$work/omarchy-names" "$work/repo-names" |
    grep -vxF -f <(grep -v '^#' "$ledger/repo-overlap.tsv" | cut -f1) >"$work/overlap.new" || true
  if [[ -s $work/overlap.new ]]; then
    section "Packages newly in both [omarchy] and the configured repositories"
    printf 'Review whether the configured repositories still win for these (ledger/repo-overlap.tsv):\n\n'
    fenced "$work/overlap.new"
  fi
fi

((findings)) || printf '\nNo changes in the areas cachyos-quattro reviews.\n'
